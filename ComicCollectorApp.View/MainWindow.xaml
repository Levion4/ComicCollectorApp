<Window x:Class="ComicCollectorApp.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComicCollectorApp.ViewModel;assembly=ComicCollectorApp.ViewModel" 
        xmlns:control="clr-namespace:ComicCollectorApp.View.Controls"
        xmlns:converter="clr-namespace:ComicCollectorApp.View.Converters"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel, IsDesignTimeCreatable=True}"
        mc:Ignorable="d"
        Title="Comic Collector" Height="600" Width="1200">
    <Window.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolConverter"/>
        <converter:ReverseBoolConverter x:Key="ReverseBoolConverter"/>
        <converter:ByteArrayToBitmapImageConverter x:Key="ByteArrayToBitmapImageConverter"/>
        <DataTemplate x:Key="comicTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Ellipse Width="30" Height="30" Margin="3, 3, 3, 3">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding CurrentComic.Image}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </StackPanel>
                <StackPanel Margin="3" Grid.Column="1">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding CurrentComic.Title}"/>
                    <TextBlock
                        FontSize="10"
                        Text="{Binding CurrentComic.TypeComic}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" ShowsPreview="False" Width="3" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="White"/>
        <Grid Background="#f8f8f8" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="8,8,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="3" Text="Find:"/>
                <TextBox Grid.Column="1" Margin="3" Text=""/>
            </Grid>
            <Grid Grid.Row="1" Margin="8,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="17*"/>
                    <RowDefinition Height="322*"/>
                </Grid.RowDefinitions>
                <ListBox Margin="3" ItemsSource="{Binding Comics}"
                         ItemTemplate="{StaticResource comicTemplate}"
                         SelectedItem="{Binding CurrentComic}" Grid.RowSpan="2"/>
            </Grid>
            <Grid Grid.Row="2" Margin="8,0,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Add" Grid.Column="0" Height="25" Width="Auto" Margin="3"
                        Command="{Binding AddCommand}" IsEnabled="{Binding IsAvailable,
                        Converter={StaticResource ReverseBoolConverter}}"/>
                <Button Content="Edit" Grid.Column="1" Height="25" Width="Auto" Margin="3"
                        Command="{Binding EditCommand}" IsEnabled="{Binding IsAvailable,
                        Converter={StaticResource ReverseBoolConverter}}"/>
                <Button Content="Remove" Grid.Column="2" Height="25" Width="Auto" Margin="3"
                        Command="{Binding RemoveCommand}" IsEnabled="{Binding IsAvailable,
                        Converter={StaticResource ReverseBoolConverter}}"/>
            </Grid>
        </Grid>
        <Grid Grid.Column="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0" Grid.Row="0">
                <Border BorderBrush="Gray" BorderThickness="1" Width="200" Height="300" Margin="3, 25, 3, 3">
                    <Image Source="{Binding CurrentComic.Image, Converter={StaticResource ByteArrayToBitmapImageConverter}}" Stretch="Uniform" />
                </Border>
                <Button Content="Add photo" Command="{Binding AddPhotoCommand}" Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Vertical">
                <TextBlock Text="Id:" Margin="3"/>
                <TextBox Margin="3"/>
                <TextBlock Text="Title:" Margin="3"/>
                <TextBox Margin="3"/>
                <TextBlock Text="Type comic:" Margin="3"/>
                <ComboBox Margin="3"/>
                <TextBlock Text="Author:" Margin="3"/>
                <ComboBox Margin="3"/>
                <TextBlock Text="Publisher:" Margin="3"/>
                <ComboBox Margin="3"/>
                <TextBlock Text="Language:" Margin="3"/>
                <ComboBox Margin="3"/>
                <TextBlock Text="Is variant cover:" Margin="3"/>
                <CheckBox Margin="3"/>
            </StackPanel>
            
            <control:SingleComicControl DataContext="{Binding CurrentComic}"
                                        IsEdit="{Binding DataContext.IsAvailable, 
                                        RelativeSource={RelativeSource AncestorType=Window},
                                        UpdateSourceTrigger=PropertyChanged}"
                                        Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch"
                                        Margin="0,20,0,0"/>

            <Button Content="Apply" Height="25" Width="75"
                    HorizontalAlignment="Center" Grid.Row="1"
                    Visibility="{Binding IsAvailable, Converter={StaticResource BoolConverter}}"
                    Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding CurrentComic.HasErrors,
                    Converter={StaticResource ReverseBoolConverter}}"/>
        </Grid>
    </Grid>
</Window>
