<Window x:Class="ComicCollectorApp.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComicCollectorApp.ViewModel;assembly=ComicCollectorApp.ViewModel" 
        xmlns:control="clr-namespace:ComicCollectorApp.View.Controls"
        xmlns:converter="clr-namespace:ComicCollectorApp.View.Converters"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel, IsDesignTimeCreatable=True}"
        mc:Ignorable="d" Title="Comic Collector" Height="650" Width="1200"
        Icon="Resources/Icon_MainWindow.png" Closed="Window_Closed" Loaded="Window_Loaded">
    <Window.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolConverter"/>
        <converter:ReverseBoolConverter x:Key="ReverseBoolConverter"/>
        <converter:ByteArrayToBitmapImageConverter x:Key="ByteArrayToBitmapImageConverter"/>
        <DataTemplate x:Key="comicTemplate">
            <Border Margin="10" Background="White" Padding="10" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle Width="90" Height="120" Margin="5" Grid.Column="0">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding Image}" />
                        </Rectangle.Fill>
                    </Rectangle>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock
                            FontSize="26"
                            FontWeight="SemiBold"
                            Foreground="DarkBlue"
                            Text="{Binding Title}" 
                            Margin="0,0,0,10"/>
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="Black"
                            Text="{Binding TypeComic}"
                            Margin="0,0,0,5"/>
                        <TextBlock
                            FontSize="18"
                            Foreground="Gray"
                            Text="{Binding Publisher.Name}"
                            Margin="0,0,0,5"/>
                        <TextBlock
                            FontSize="18"
                            Foreground="Gray"
                            Text="{Binding Language.Name}"
                            Margin="0,0,0,5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.6*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" ShowsPreview="False" Width="3" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="White"/>
        <Grid Background="#f8f8f8" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="8,8,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="3" Text="Find:"/>
                <TextBox Grid.Column="1" Margin="3" Text=""/>
            </Grid>
            <Grid Grid.Row="1" Margin="8,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="17*"/>
                    <RowDefinition Height="322*"/>
                </Grid.RowDefinitions>
                <ListBox Margin="3" ItemsSource="{Binding Comics}"
                         ItemTemplate="{StaticResource comicTemplate}"
                         SelectedItem="{Binding CurrentComic}" Grid.RowSpan="2"/>
            </Grid>
            <Grid Grid.Row="2" Margin="8,0,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Add a single" Grid.Column="0" Height="25" Width="Auto" Margin="3"
                        Command="{Binding AddSingleCommand}" IsEnabled="{Binding IsAvailable,
                        Converter={StaticResource ReverseBoolConverter}}"/>
                <Button Content="Add a collection" Grid.Column="1" Height="25" Width="Auto" Margin="3"
                        Command="{Binding AddCollectionCommand}" IsEnabled="{Binding IsAvailable,
                        Converter={StaticResource ReverseBoolConverter}}"/>
                <Button Content="Edit" Grid.Column="2" Height="25" Width="Auto" Margin="3"
                        Command="{Binding EditCommand}" IsEnabled="{Binding IsAvailable,
                        Converter={StaticResource ReverseBoolConverter}}"/>
                <Button Content="Remove" Grid.Column="3" Height="25" Width="Auto" Margin="3"
                        Command="{Binding RemoveCommand}" IsEnabled="{Binding IsAvailable,
                        Converter={StaticResource ReverseBoolConverter}}"/>
            </Grid>
        </Grid>
        <Grid Grid.Column="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0" Grid.Row="0">
                <Border BorderBrush="Gray" BorderThickness="1" Width="200" Height="300" Margin="3, 25, 3, 3">
                    <Image Source="{Binding CurrentComic.Image, Converter={StaticResource ByteArrayToBitmapImageConverter}}" Stretch="Uniform" />
                </Border>
                <Button Content="Add photo" Command="{Binding AddPhotoCommand}" Margin="0,10,0,0"
                        Visibility="{Binding IsAvailable, Converter={StaticResource BoolConverter}}"/>
            </StackPanel>

            <control:ComicControl 
                     DataContext="{Binding CurrentComic}"
                     ParentContext="{Binding DataContext, 
                     RelativeSource={RelativeSource AncestorType=Window}}"
                     IsEdit="{Binding DataContext.IsAvailable, 
                     RelativeSource={RelativeSource AncestorType=Window},
                     UpdateSourceTrigger=PropertyChanged}"
                     Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                     HorizontalAlignment="Stretch"/>

            <control:SingleComicControl
                     DataContext="{Binding CurrentComic}"
                     IsEdit="{Binding DataContext.IsAvailableSingleComic, 
                     RelativeSource={RelativeSource AncestorType=Window},
                     UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Stretch"
                     Grid.Column="1" Grid.Row="1"
                     Margin="0,20,0,0"/>

            <Button Content="Apply" Height="25" Width="75"
                    HorizontalAlignment="Center" Grid.Row="1"
                    Visibility="{Binding IsAvailable, Converter={StaticResource BoolConverter}}"
                    Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding CurrentComic.HasErrors,
                    Converter={StaticResource ReverseBoolConverter}}"/>
        </Grid>
    </Grid>
</Window>
