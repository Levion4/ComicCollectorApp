<Window x:Class="ComicCollectorApp.View.ComicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComicCollectorApp.View"
        xmlns:control="clr-namespace:ComicCollectorApp.View.Controls"
        mc:Ignorable="d"
        Title="ComicWindow" Height="550" Width="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0" Grid.Row="0">
                <Image Source="{Binding }" Width="200" Height="300" Margin="3, 25, 3, 3"/>
            </StackPanel>

            <control:SingleComicControl DataContext="{Binding CurrentComic}"
                     Grid.Column="0" Grid.Row="1" HorizontalAlignment="Stretch" 
                     Margin="3,3,3,3" />
        </Grid>

        <StackPanel Grid.Column="1" Orientation="Vertical">
            <TextBlock Text="Id:" Margin="3"/>
            <TextBox/>
            <TextBlock Text="Title:" Margin="3"/>
            <TextBox/>
            <TextBlock Text="Type comic:" Margin="3"/>
            <ComboBox/>
            <TextBlock Text="Author:" Margin="3"/>
            <ComboBox/>
            <TextBlock Text="Publisher:" Margin="3"/>
            <ComboBox/>
            <TextBlock Text="Language:" Margin="3"/>
            <ComboBox/>
            <TextBlock Text="Is variant cover:" Margin="3"/>
            <CheckBox />
        </StackPanel>
    </Grid>
</Window>
